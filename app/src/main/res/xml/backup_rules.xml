<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower Auto Backup allow-list.

  User-created patch data is backed up. Reconstructable module binaries,
  imported sample copies, logs, installer transactions, and caches are not.
  Keeping this narrow also protects the Auto Backup quota.
-->
<full-backup-content>
	<include domain="file" path="user/patches" />
	<include domain="file" path="user/autosave" />
	<include domain="file" path="user/recovery" />
	<include domain="file" path="user/rack-theme.txt" />

	<include domain="sharedpref" path="ui.xml" />
	<include domain="sharedpref" path="guide.xml" />
	<include domain="sharedpref" path="toolbar.xml" />
	<include domain="sharedpref" path="locks.xml" />
	<include domain="sharedpref" path="theme.xml" />
</full-backup-content>
