<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideload-only networking capability.

  INTERNET is retained so future Android-compatible third-party modules are
  not needlessly prevented from networking. RackDroid's self-updater itself
  is disabled in AppUpdates.kt.

  The install-packages permission is deliberately absent: this build must not
  install a replacement RackDroid APK on its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />
</manifest>
